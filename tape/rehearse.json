ill due"}},{"id":"rtx4060/whisper","node":"rtx4060","service":"whisper","source":"argus-http","model":null,"vram_mb":980,"idle_s":420.2,"busy":false,"host_ram_mb":null,"peak_mb":980,"expires_at":null,"detail":{"pids":[4004],"model_state":"gpu","status":"ok"},"tenant":null,"policy":null}],"services":[{"id":"ollama-rtx4060","node":"rtx4060","adapter":"ollama","base_url":"http://rtx4060:11434","up":true,"error":null,"queue_running":null,"queue_pending":null,"available":["gemma3:4b","qwen3:8b"],"need_mb":null,"room_mb":null,"crowded_out":false},{"id":"xtts","node":"rtx4060","adapter":"argus-http","base_url":"http://rtx4060:8141","up":true,"error":null,"queue_running":null,"queue_pending":null,"available":null,"need_mb":null,"room_mb":null,"crowded_out":false},{"id":"whisper","node":"rtx4060","adapter":"argus-http","base_url":"http://rtx4060:8144","up":true,"error":null,"queue_running":null,"queue_pending":null,"available":null,"need_mb":980,"room_mb":7680,"crowded_out":false}]}},{"e":"node","d":{"name":"gtx1070","agent_url":"http://gtx1070:9110","reachable":true,"last_seen":"2026-11-25T09:00:20.240000Z","error":null,"gpu":{"index":0,"name":"NVIDIA GeForce GTX 1070 Ti","uuid":"GPU-gtx1070","total_mb":8192,"free_mb":7582,"used_mb":610,"util_pct":0,"compute_capability":"6.1","bf16":false},"host":{"total_mb":32768,"available_mb":24100},"ledger":{"total_mb":8192,"free_mb":7582,"reserve_mb":0,"headroom_mb":512,"resident_mb":610,"unattributed_mb":0,"admissible_mb":7070,"pinned_mb":610,"held_mb":610,"room_mb":7070},"residents":[{"id":"gtx1070/ollama-gtx1070/nomic-embed-text:latest","node":"gtx1070","service":"ollama-gtx1070","source":"ollama","model":"nomic-embed-text:latest","vram_mb":610,"idle_s":360.2,"busy":false,"host_ram_mb":null,"peak_mb":610,"expires_at":null,"detail":{"size_mb":610,"partial_offload":false,"context_length":8192},"tenant":null,"policy":{"rule":0,"enforce":false,"pinned":true,"idle_s":360.2,"idle_kill_s":null,"due_in_s":null,"next":"pin","note":"pinned: keep_alive -1"}}],"services":[{"id":"ollama-gtx1070","node":"gtx1070","adapter":"ollama","base_url":"http://gtx1070:11434","up":true,"error":null,"queue_running":null,"queue_pending":null,"available":["nomic-embed-text:latest","qwen3:8b"],"need_mb":null,"room_mb":null,"crowded_out":false}]}}],"events":[],"logs":[],"beats":[{"t":4.0,"title":"Production's policy, on a broker that cannot act","text":"This is a second broker, beside production on the same GPUs, with production's config and one new rule: unload qwen3:8b after 10 idle minutes, enforce: true. It has been idle for 22 minutes, so the rule is due. But this broker runs with IRIS_REPORT_ONLY=1, so the dashboard says it would idle-kill, and admission is observe-only.","focus":"rtx4060"},{"t":16.0,"title":"Asked to evict, it refuses","text":"A manual evict gets “this broker is report-only (IRIS_REPORT_ONLY): it never acts”, even with the right token. Enforced rules act through the services themselves, Ollama's keep_alive and the services' unload routes, so withholding tokens is not enough. Report-only is a switch in the broker, and /health shows it.","focus":"rtx4060"},{"t":616.0,"title":"Ten minutes on, nothing has moved","text":"qwen3:8b still holds 4.5 GB and the rule still only reports. Not one event has reached the dashboard in ten minutes: nothing changed to send. A rehearsal shows what a policy would do to the real cards without letting it do any of it.","focus":"rtx4060"},{"t":624.0,"title":"Approved before production sees it","text":"Before either broker loaded the file, argus-iris check validated it with this release's own code and listed what needs a person: “enforced rule new or changed: {\"node\": \"rtx4060\", \"ollama\": \"qwen3:*\"}; policy changed: residents”. Approve it, and production's broker unloads the model, confirmed by the GPU, as in Trust the GPU.","focus":"rtx4060"}]}
